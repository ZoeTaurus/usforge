// Cloudflare Worker settings: serve the site's files, and run worker/index.js for /api (uploads).
{
  "name": "usforge",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": ".", "binding": "ASSETS", "not_found_handling": "404-page",
    // the Worker adds link previews (title, description, cover) to game and maker pages
    "run_worker_first": ["/api/*", "/play", "/play.html", "/maker", "/maker.html"] },
  // keep variables set in the Cloudflare dashboard (like GITHUB_TOKEN) when the site redeploys
  "keep_vars": true,
  // play counts live in one small Durable Object (created automatically on deploy; free plan)
  "durable_objects": { "bindings": [{ "name": "PLAYS", "class_name": "Plays" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Plays"] }]
}
